---
import { Font } from "astro:assets";
import { href } from "../url";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { practice } from "../site";
import { gaMeasurementId } from "../analytics";
import { person, professionalService, website } from "../schema";
import { portraitUrl } from "../og";
import favicon16 from "../assets/images/favicon-16.png";
import favicon32 from "../assets/images/favicon-32.png";
import appleTouchIcon from "../assets/images/favicon-180.png";
import "../styles/style.css";

interface Props {
  title: string;
  description: string;
  /** Optional meta keywords for this page. */
  keywords?: readonly string[];
  /** Extra schema.org nodes for this page, merged into the global @graph. */
  schema?: unknown[];
  /** Keeps the page out of search results. */
  noindex?: boolean;
  /** Overrides the default social-share image. */
  ogImage?: ImageMetadata;
  /** Alt text describing the share image. */
  ogImageAlt?: string;
}

const {
  title,
  description,
  keywords,
  schema = [],
  noindex = false,
  ogImage,
  ogImageAlt = `${practice.counsellor}, ${practice.registration} ${practice.jobTitle}`,
} = Astro.props;

// Social crawlers need a fixed, absolute image URL, so the share image is
// rendered at a known size rather than relying on a content-hashed srcset.
const ogUrl = await portraitUrl(Astro.site, ogImage);

// The practice, Emma herself and the site are the identity anchors every page
// cross-references by @id (ProfessionalService names #emma as its founder and
// provider), so all three are emitted on every page. Pages add only their own
// page-level nodes on top.
const graph = [
  professionalService(Astro.site, ogUrl),
  person(Astro.site, ogUrl),
  website(Astro.site),
  ...schema,
];

// Escaping "<" stops any string containing "</script>" from closing the tag.
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(
  /</g,
  "\\u003c",
);

// Fonts are self-hosted at build time (see `fonts` in astro.config.mjs); only
// the regular weight is preloaded, the rest load on demand.
const preload = [{ weight: "400", style: "normal" }];
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEO
      title={title}
      description={description}
      keywords={keywords}
      noindex={noindex}
      ogImageUrl={ogUrl}
      ogImageAlt={ogImageAlt}
    />

    <meta name="theme-color" content="#23422F" />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
    <link rel="sitemap" href={href("/sitemap-index.xml")} />

    <Font cssVariable="--font-display" preload={preload} />
    <Font cssVariable="--font-body" preload={preload} />

    <script type="application/ld+json" set:html={jsonLd} is:inline />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {gaMeasurementId && <CookieConsent />}
  </body>
</html>
