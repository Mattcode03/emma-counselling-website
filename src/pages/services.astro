---
import { href } from "../url";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoHero from "../components/PhotoHero.astro";
import CtaBand from "../components/CtaBand.astro";
import PackageOffer from "../components/PackageOffer.astro";
import { fees, supportAreas } from "../site";
import { breadcrumbs, abs } from "../schema";
import heroImage from "../assets/images/gradient-2.jpg";
import individualImage from "../assets/images/counsel-service_1.jpg";
import couplesImage from "../assets/images/couples-counselling.jpg";

const title = "Counselling Services & Fees | Emma Rossouw, Cape Town";
const description =
  "Individual & couples online counselling for anxiety, stress, relationships & more — sessions across South Africa from R400. Free 20-min consultation.";

const offerings = [
  {
    image: individualImage,
    alt: "A counsellor taking notes during a one-to-one session",
    heading: "Individual online counselling",
    body: "For children, adolescents, and adults, tailored to your specific needs, goals, and circumstances. We work at your pace, in a space where you can speak openly.",
    price: "R400",
  },
  {
    image: couplesImage,
    alt: "Couples online counselling",
    heading: "Couples online counselling",
    body: "A collaborative, person-centred space to work through relationship, marriage, and family challenges together — with both of you heard.",
    price: "R600",
  },
];

// The concerns people search for most, each with a short explanation. `area`
// names the matching supportAreas entry, which is then left out of the tag
// list below so it isn't shown twice.
const focusAreas = [
  {
    area: "Anxiety and stress",
    heading: "Anxiety and stress counselling",
    body: "Anxiety can show up as racing thoughts, trouble sleeping, or a constant sense of being on edge. Together we look at what's driving it and build practical ways to cope, at a pace that feels manageable for you.",
  },
  {
    area: "Relationship, marriage, and family challenges",
    heading: "Couples and relationship counselling",
    body: "Whether you come on your own or together as a couple, sessions offer a space to work through conflict, communication difficulties, and changes in a relationship, marriage, or family, with each person heard.",
  },
  {
    area: "Burnout and workplace wellbeing",
    heading: "Burnout and workplace wellbeing",
    body: "When work or study leaves you exhausted, detached, or running on empty, we can explore what's contributing to it, set healthier boundaries, and find ways to restore some balance in your day-to-day life.",
  },
  {
    area: "Grief and loss",
    heading: "Grief and loss counselling",
    body: "Grief doesn't follow a timeline. Whether you're mourning a person, a relationship, or a way of life, counselling offers a gentle, unhurried space to process your loss and find ways to carry it.",
  },
];

const focusAreaNames: readonly string[] = focusAreas.map((focus) => focus.area);
const otherAreas = supportAreas.filter((area) => !focusAreaNames.includes(area));

const pageUrl = abs(Astro.site, "/services/");

const schema = [
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Online counselling",
    serviceType: "Online wellness counselling",
    description:
      "Secure online counselling sessions for individuals and couples, delivered by video anywhere in South Africa by an ASCHP Registered Specialist Wellness Counsellor.",
    url: pageUrl,
    provider: { "@id": `${abs(Astro.site, "/")}#practice` },
    areaServed: { "@type": "Country", name: "South Africa" },
    availableChannel: {
      "@type": "ServiceChannel",
      serviceUrl: abs(Astro.site, "/contact/"),
      name: "Online video sessions",
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Session fees",
      itemListElement: fees.map((fee) => ({
        "@type": "Offer",
        name: fee.schemaName,
        description: fee.blurb,
        price: fee.price,
        priceCurrency: "ZAR",
        availability: "https://schema.org/InStock",
        itemOffered: { "@type": "Service", name: fee.schemaName },
      })),
    },
  },
  breadcrumbs(Astro.site, [{ name: "Services & fees", path: "/services/" }]),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PhotoHero
    image={heroImage}
    eyebrow="Services"
    title="Online Counselling Services in South Africa"
    description="Secure online sessions for clients across South Africa — professional support from the comfort and privacy of your own space."
    variant="interior"
    class="photo-hero--gold-heading"
  />

  <section class="section">
    <div class="container">
      <div class="media-grid media-grid--wide">
        {
          offerings.map((offering) => (
            <div class="service-card">
              <div class="media-card-image">
                <Image
                  src={offering.image}
                  alt={offering.alt}
                  width={960}
                  height={540}
                  fit="cover"
                  widths={[520, 1040, 1560]}
                  sizes="(max-width: 760px) 90vw, 520px"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="service-card-body">
                <h2>{offering.heading}</h2>
                <p>{offering.body}</p>
                <div class="service-meta">
                  <span>1 hour</span>
                  <span class="dot">&middot;</span>
                  <span>Online, secure video</span>
                  <span class="dot">&middot;</span>
                  <span class="price">{offering.price}</span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
      <PackageOffer />
    </div>
  </section>

  <section class="section section--sage">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Areas I commonly support</span>
        <h2 style="color: var(--forest-deep);">I work with a wide range of concerns</h2>
        <p>
          If you're unsure whether your concern falls within these areas, please don't hesitate to
          get in touch. Together, we can determine the most appropriate way to support you.
        </p>
      </div>
      <div class="grid grid-2 focus-areas">
        {
          focusAreas.map((focus) => (
            <div class="approach-card">
              <h3>{focus.heading}</h3>
              <p>{focus.body}</p>
            </div>
          ))
        }
      </div>
      <h3 class="focus-areas-more">I also support</h3>
      <ul class="tag-list tag-list--center">
        {otherAreas.map((area) => <li>{area}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Session fees</h2>
      </div>
      <div class="pricing-grid">
        {
          fees.map((fee) => (
            <div class="price-card">
              <div class="eyebrow">{fee.eyebrow}</div>
              <div class="price-amount">{fee.amount}</div>
              <div class="price-amount-note">{fee.note}</div>
              <p>{fee.blurb}</p>
              <a href={href("/contact/")} class="btn btn-primary">
                Book now
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    heading="Not sure where to start?"
    body="Reach out and we'll figure out together whether counselling is the right fit for you."
  />
</BaseLayout>
