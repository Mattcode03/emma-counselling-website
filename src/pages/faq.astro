---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoHero from "../components/PhotoHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { allFaqs, faqGroups } from "../faqs";
import { breadcrumbs, abs } from "../schema";
import heroImage from "../assets/images/gradient-2.jpg";

const title = "Online Counselling FAQs | Emma Rossouw, Cape Town";
const description =
  "Answers to common questions about booking, sessions, fees, and confidentiality for online counselling with Emma Rossouw, ASCHP Specialist Wellness Counsellor.";

const schema = [
  {
    "@type": "FAQPage",
    "@id": `${abs(Astro.site, "/faq/")}#webpage`,
    url: abs(Astro.site, "/faq/"),
    isPartOf: { "@id": `${abs(Astro.site, "/")}#website` },
    mainEntity: allFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
  breadcrumbs(Astro.site, [{ name: "Questions", path: "/faq/" }]),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PhotoHero
    image={heroImage}
    eyebrow="Questions"
    title="Things people often ask"
    variant="short"
    class="photo-hero--gold-heading"
  />

  {
    faqGroups.map((group) => (
      <section class:list={["section", { "section--sage": group.tinted }]}>
        <div class="container">
          <div class="faq-group">
            <h2 class="faq-group-label">{group.label}</h2>
            <div class="faq-list">
              {group.items.map((item) => (
                <div class="faq-item">
                  <h3>{item.q}</h3>
                  <p>{item.a}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand
    heading="Still have a question?"
    body="If you don't see the answer here, send a message and I'll get back to you directly."
    label="Get in touch"
  />
</BaseLayout>
