---
import { href as withBase } from "../url";
import { navLinks, practice } from "../site";

/**
 * Pathname of the current page. In a based deployment this already includes
 * the base (e.g. "/emma-counselling-website/about/"), so links are compared
 * after the same prefix is applied rather than in their raw "/about/" form.
 */
const path = Astro.url.pathname;

/** Trailing-slash-insensitive match so "/about" and "/about/" both work. */
const normalise = (value: string) =>
  value === "/" ? "/" : value.replace(/\/$/, "");
const isActive = (link: string) => normalise(path) === normalise(withBase(link));
---

<header class="site-header">
  <nav class="nav" aria-label="Main navigation">
    <a href={withBase("/")} class="nav-logo">
      {practice.nameParts.lead} <span>{practice.nameParts.accent}</span>
    </a>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span><span></span>
    </button>
    <ul class="nav-links" id="nav-links">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={withBase(link.href)}
              class:list={[{ active: isActive(link.href) }]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="nav-cta">
        <a href={withBase("/contact/")} class="btn btn-primary">Book a free call</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Mobile nav toggle. Astro bundles and defers this automatically, and it is
  // scoped to the component rather than a global js/nav.js include.
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const links = document.querySelector<HTMLUListElement>(".nav-links");

  if (toggle && links) {
    toggle.addEventListener("click", () => {
      const isOpen = links.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });
  }
</script>
