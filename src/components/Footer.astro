---
import { footerColumns, practice } from "../site";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          {practice.nameParts.lead} <span>{practice.nameParts.accent}</span>
        </div>
        <p class="footer-nap">
          {practice.tagline}<br />
          {practice.city}, {practice.region}, {practice.countryName}<br />
          <a href={`tel:${practice.phone}`}>{practice.phoneDisplay}</a><br />
          <a href={`mailto:${practice.email}`}>{practice.email}</a>
        </p>
        <div class="footer-social">
          <a
            href={practice.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${practice.counsellor} on LinkedIn`}
            title={`${practice.counsellor} on LinkedIn`}
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path
                d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.26 2.36 4.26 5.44v6.3zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
      <div class="footer-nav">
        {
          footerColumns.map((column) => (
            <ul class="footer-nav-col">
              {column.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} {practice.name}. All rights reserved.</span>
      <span>{practice.footerCredential}</span>
    </div>
  </div>
</footer>
